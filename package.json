{
    "name": "l2encdec",
    "version": "1.0.6",
    "description": "encrypt/decrypt L2 files",
    "type": "module",
    "bin": {
        "l2encdec": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
