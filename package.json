        "l2encdec",
        "lineage2",
        "encryption",
        "decryption",
        "typescript",
        "javascript"
    ],
    "author": "ritsuwastaken",
    "license": "Unlicense",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ritsuwastaken/l2encdec.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test \"test/**/*.test.ts\"",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "7.0.2"
    }
}
